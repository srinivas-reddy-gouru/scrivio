# Scrivio settings. Copy to .env and fill in what you use:
#
#     cp .env.example .env
#
# Everything here is optional. With nothing set, Scrivio starts, tells you
# that no provider is configured, and refuses to run rather than show
# made-up results. The Settings screen edits this same file.
#
# Values are read literally. "${NAME}" is not expanded and "#" does not
# start a comment inside a quoted value.


# ── A model provider: you need ONE of these three ─────────────────────────

# 1. Anthropic. Runs writing, grading, tailoring, and fact-checking.
ANTHROPIC_API_KEY=

# 2. OpenAI. Runs everything when it is the only key. When both keys are
#    set, writing runs on the LLM_PROVIDER below and fact-checking on OpenAI.
OPENAI_API_KEY=

# 3. A subscription, through a command-line assistant you have installed
#    and signed in to. No key needed. Set LLM_PROVIDER=claude-cli and,
#    if it is not Claude Code, name it:
#      claude (Claude Pro/Max) | codex (ChatGPT) | gemini | qwen | ollama
# LLM_CLI=claude

# Which provider to prefer when more than one is available:
#   anthropic | openai | claude-cli
# LLM_PROVIDER=anthropic


# ── Models (optional: leave unset for the defaults) ───────────────────────

# ANTHROPIC_STRONG_MODEL=
# ANTHROPIC_LIGHT_MODEL=
# OPENAI_STRONG_MODEL=
# OPENAI_LIGHT_MODEL=
# CLAUDE_CLI_MODEL=
# CLI_STRONG_MODEL=
# CLI_LIGHT_MODEL=
# CLI_FORCE_MODEL=


# ── Web search, for articles and interview research (optional) ────────────
# Any one of these. Without one, search uses the command-line assistant's
# own web search if there is one, and otherwise is skipped.

TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=

# Fallback reader for pages that block direct fetching.
# JINA_API_KEY=
USE_JINA_READER=false


# ── Voice (optional) ──────────────────────────────────────────────────────
# Uses OPENAI_API_KEY above. Without it the browser's own voice and
# dictation are used.

# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=sage
# TRANSCRIBE_MODEL=whisper-1


# ── Where things are kept ─────────────────────────────────────────────────

# Articles, resumes, and interview sessions.
# ARTICLE_OUTPUT_DIR=./output

# The session key for paired browsers.
# SCRIVIO_STATE_DIR=./.scrivio


# ── How it is served ──────────────────────────────────────────────────────
# These are read from the ENVIRONMENT when the server starts, not from this
# file, because they decide how the server starts. They are listed here so
# that they are documented in one place.
#
#   PORT=8899
#   SCRIVIO_HOST=127.0.0.1         Loopback. Change only if you mean to.
#   SCRIVIO_ALLOWED_HOSTS=         Extra host names to answer to, comma separated.
#   SCRIVIO_ALLOWED_ORIGINS=       Extra origins allowed to call the API.
#   SCRIVIO_DEMO=1                 Canned examples, no model calls. Labelled.
#   SCRIVIO_ENV_FILE=              Use a settings file other than ./.env
#   MERMAID_CLI=                   Path to mmdc, if not installed by
#                                  scripts/setup_renderers.py
